# GEMINI_API_KEY: Required for Gemini AI Smart Import calls (Server-side)
GEMINI_API_KEY=

# Firebase Client Environment Variables
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Resend API Key (Optional: for live weekly report email delivery)
RESEND_API_KEY=

# NODE_ENV: Environment mode (development / production)
NODE_ENV=production

# PORT: Server port (defaults to 3000 if not provided by host)
PORT=3000
